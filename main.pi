from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from pydantic import BaseModel
from apscheduler.schedulers.background import BackgroundScheduler
import sqlite3, datetime, os

app = FastAPI()

app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

scheduler = BackgroundScheduler()
scheduler.start()

def init_db():
    conn = sqlite3.connect("tasks.db")
    conn.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            time TEXT,
            done INTEGER DEFAULT 0
        )
    """)
    conn.commit()
    conn.close()

init_db()

class Task(BaseModel):
    name: str
    time: str = None

@app.get("/tasks")
def get_tasks():
    conn = sqlite3.connect("tasks.db")
    rows = conn.execute("SELECT id, name, time, done FROM tasks").fetchall()
    conn.close()
    return [{"id": r[0], "name": r[1], "time": r[2], "done": bool(r[3])} for r in rows]

@app.post("/tasks")
def add_task(task: Task):
    conn = sqlite3.connect("tasks.db")
    cursor = conn.execute("INSERT INTO tasks (name, time) VALUES (?, ?)", (task.name, task.time))
    conn.commit()
    task_id = cursor.lastrowid
    conn.close()
    return {"id": task_id, "name": task.name, "time": task.time, "done": False}

@app.put("/tasks/{task_id}")
def update_task(task_id: int, task: Task):
    conn = sqlite3.connect("tasks.db")
    conn.execute("UPDATE tasks SET done=1 WHERE id=?", (task_id,))
    conn.commit()
    conn.close()
    return {"message": "updated"}

@app.delete("/tasks/{task_id}")
def delete_task(task_id: int):
    conn = sqlite3.connect("tasks.db")
    conn.execute("DELETE FROM tasks WHERE id=?", (task_id,))
    conn.commit()
    conn.close()
    return {"message": "deleted"}